{
  "expo": {
    "name": "Sam Services",
    "slug": "sd_cards_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sdcards.mobile",
      "infoPlist": {
        "NFCReaderUsageDescription": "Permite a Sam Services programar y verificar tarjetas NFC físicas para mesas y reseñas",
        "NSCameraUsageDescription": "Permite a Sam Services escanear códigos de tarjetas físicas para su vinculación y diagnóstico."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF",
          "TAG"
        ]
      }
    },
    "android": {
      "package": "com.sdcards.mobile",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#040814",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Permite a Sam Services programar y verificar tarjetas NFC físicas para mesas y reseñas"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a Sam Services escanear códigos de tarjetas físicas para su vinculación y diagnóstico."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "56319a5d-5725-44c8-bc8e-bfac8d7631c9"
      }
    }
  }
}
