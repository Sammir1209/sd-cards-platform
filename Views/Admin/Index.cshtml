@model NfcMenuSaas.Models.Business
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Panel de Negocio - " + Model.Name;
    var presets = ViewBag.SectorPresets as List<string> ?? new List<string>();
}

<!-- Barra Superior App Nativa Mobile -->
<header class="bg-slate-950 text-white px-5 py-4 flex items-center justify-between shadow-xl sticky top-0 z-40 border-b border-white/10">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 flex items-center justify-center font-black text-lg text-white shadow-lg shadow-blue-500/20">
            @Model.Name.Substring(0, 1)
        </div>
        <div>
            <h1 class="text-sm font-black truncate leading-tight">@Model.Name</h1>
            <span class="text-[10px] text-blue-400 font-bold uppercase tracking-wider">Rubro: @Model.Sector</span>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <a href="/site/@Model.Slug" target="_blank" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-[11px] font-bold text-emerald-400 flex items-center gap-1.5 transition">
            <span>Ver Web</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
    </div>
</header>

@if (TempData["Message"] != null)
{
    <div class="mx-4 mt-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl text-xs font-bold flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>@TempData["Message"]</span>
    </div>
}

<div class="p-4 space-y-6 pb-24">

    <!-- SECCIÓN 1: AJUSTES DE TARJETA & DOMINIO PROPIO -->
    <section class="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-4">
        <h2 class="text-xs font-black uppercase tracking-wider text-slate-700 flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Ajustes del Negocio & Marca
        </h2>

        <form method="post" action="/admin/update-settings" class="space-y-3">
            <input type="hidden" name="id" value="@Model.Id" />

            <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">Nombre del Negocio</label>
                <input type="text" name="name" value="@Model.Name" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 font-bold" />
            </div>

            @if (Model.TemplateType == NfcMenuSaas.Models.TemplateType.GoogleReviews)
            {
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Enlace de Reseña de Google Maps (Place ID URL)</label>
                    <input type="url" name="googleMapsUrl" value="@Model.GoogleMapsUrl" placeholder="https://search.google.com/local/writereview?placeid=..." class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
                </div>

                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-2xl border border-slate-100">
                    <div>
                        <span class="text-xs font-bold text-slate-800 block">Redirección Instantánea (302)</span>
                        <span class="text-[10px] text-slate-500">Abre directamente Google Maps sin preguntas al tocar la tarjeta</span>
                    </div>
                    <input type="checkbox" name="autoRedirectReviews" value="true" @(Model.AutoRedirectReviews ? "checked" : "") class="w-5 h-5 rounded text-blue-600 focus:ring-blue-500" />
                </div>
            }

            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Color de Marca</label>
                    <input type="color" name="primaryColor" value="@Model.PrimaryColor" class="h-9 w-full rounded-xl cursor-pointer p-0.5 border border-slate-200" />
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-700 mb-1">Rubro de Negocio</label>
                    <select name="sector" class="w-full h-9 px-2 text-xs rounded-xl border border-slate-200 focus:outline-none font-bold">
                        @foreach (var sec in Enum.GetValues<NfcMenuSaas.Models.BusinessSector>())
                        {
                            if (sec == Model.Sector)
                            {
                                <option value="@sec" selected>@sec</option>
                            }
                            else
                            {
                                <option value="@sec">@sec</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <button type="submit" class="w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-black transition active:scale-95 flex items-center justify-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>Guardar Ajustes</span>
            </button>
        </form>
    </section>

    <!-- SECCIÓN 2: CATEGORÍAS PRECONFIGURADAS SEGÚN EL RUBRO -->
    <section class="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
            <h2 class="text-xs font-black uppercase tracking-wider text-slate-700">Sugerencias para @Model.Sector</h2>
            <span class="text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">1-Click</span>
        </div>
        <p class="text-[11px] text-slate-400">Toca para agregar a tu carta al instante:</p>
        
        <div class="flex flex-wrap gap-1.5">
            @foreach (var catName in presets)
            {
                <form method="post" action="/admin/add-category" class="inline">
                    <input type="hidden" name="businessId" value="@Model.Id" />
                    <input type="hidden" name="categoryName" value="@catName" />
                    <button type="submit" class="px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-bold border border-blue-200 transition flex items-center gap-1 active:scale-95">
                        <svg class="w-3 h-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        <span>@catName</span>
                    </button>
                </form>
            }
        </div>

        <form method="post" action="/admin/add-category" class="flex gap-2 pt-2">
            <input type="hidden" name="businessId" value="@Model.Id" />
            <input type="text" name="categoryName" placeholder="Otra categoría personalizada..." required class="flex-1 px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium" />
            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold transition">
                Agregar
            </button>
        </form>
    </section>

    <!-- SECCIÓN 3: GESTIÓN DE PLATOS / PRODUCTOS (CON SINCRONIZACIÓN EN TIEMPO REAL) -->
    <section class="space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-xs font-black uppercase tracking-wider text-slate-700">Tu Menú en Tiempo Real</h2>
            <span class="text-[11px] font-bold text-slate-400">@Model.Categories.Count categorías</span>
        </div>

        @if (!Model.Categories.Any())
        {
            <div class="p-8 text-center bg-white rounded-3xl border border-dashed border-slate-200">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-slate-50 text-slate-400 flex items-center justify-center mb-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </div>
                <p class="text-xs text-slate-500 font-bold">Tu menú está esperando tus primeros platos.</p>
                <p class="text-[11px] text-slate-400 mt-1">Usa los botones azules arriba para agregar tus categorías en 1 segundo.</p>
            </div>
        }

        @foreach (var cat in Model.Categories)
        {
            <div class="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <h3 class="font-extrabold text-sm text-slate-900 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
                        @cat.Name
                    </h3>
                    <span class="text-[10px] font-bold text-slate-400 bg-slate-50 px-2 py-0.5 rounded-full">@cat.Dishes.Count platos</span>
                </div>

                <div class="space-y-2">
                    @foreach (var dish in cat.Dishes)
                    {
                        <div class="p-3 rounded-2xl border border-slate-100 flex items-center justify-between gap-3 @(dish.IsAvailable ? "bg-slate-50/70" : "bg-rose-50/50 opacity-60")">
                            <div class="flex-1 min-w-0">
                                <p class="text-xs font-bold text-slate-800 truncate">@dish.Name</p>
                                <p class="text-[11px] font-extrabold text-blue-600">S/ @dish.Price.ToString("F2")</p>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <form method="post" action="/admin/toggle-dish">
                                    <input type="hidden" name="businessId" value="@Model.Id" />
                                    <input type="hidden" name="dishId" value="@dish.Id" />
                                    <button type="submit" class="px-2.5 py-1 rounded-xl text-[10px] font-black transition active:scale-95 @(dish.IsAvailable ? "bg-emerald-100 text-emerald-800" : "bg-rose-100 text-rose-800")">
                                        @(dish.IsAvailable ? "Disponible" : "Agotado")
                                    </button>
                                </form>
                                <form method="post" action="/admin/delete-dish" onsubmit="return confirm('¿Eliminar producto?');">
                                    <input type="hidden" name="businessId" value="@Model.Id" />
                                    <input type="hidden" name="dishId" value="@dish.Id" />
                                    <button type="submit" class="p-1.5 rounded-xl text-slate-400 hover:text-rose-600 transition">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>

                <details class="group pt-1">
                    <summary class="text-xs font-extrabold text-blue-600 cursor-pointer list-none flex items-center gap-1.5 hover:text-blue-700">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        <span>Agregar nuevo plato a @cat.Name</span>
                    </summary>
                    <form method="post" action="/admin/add-dish" class="mt-3 space-y-2 pt-3 border-t border-slate-100">
                        <input type="hidden" name="businessId" value="@Model.Id" />
                        <input type="hidden" name="categoryId" value="@cat.Id" />

                        <input type="text" name="name" placeholder="Nombre (ej. 1/4 Pollo + Papas)" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 font-bold" />
                        
                        <div class="grid grid-cols-2 gap-2">
                            <input type="number" step="0.50" name="price" placeholder="Precio (S/)" required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 font-bold" />
                            <input type="url" name="imageUrl" placeholder="URL Foto (opcional)" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        </div>

                        <input type="text" name="description" placeholder="Descripción breve..." class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />

                        <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-black shadow-lg shadow-blue-500/20 transition active:scale-95 flex items-center justify-center gap-2">
                            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Guardar Plato en Tiempo Real</span>
                        </button>
                    </form>
                </details>
            </div>
        }
    </section>
</div>

<!-- Barra Flotante Inferior Estilo App Móvil con Iconos Vectoriales Pulidos -->
<nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-white/95 backdrop-blur-md border-t border-slate-200 px-6 py-2.5 flex items-center justify-around z-50 shadow-2xl">
    <a href="/admin/@Model.Id" class="flex flex-col items-center gap-1 text-blue-600 font-bold text-[10px]">
        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        <span>Menú</span>
    </a>
    <a href="/site/@Model.Slug" target="_blank" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-700 font-medium text-[10px]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
        <span>Web</span>
    </a>
    <a href="/superadmin" class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-700 font-medium text-[10px]">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span>S & D</span>
    </a>
</nav>
