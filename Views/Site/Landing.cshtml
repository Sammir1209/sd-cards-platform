@model NfcMenuSaas.Models.Business
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = Model.Name + " - Bienvenidos";
    var primary = string.IsNullOrEmpty(Model.PrimaryColor) ? "#D97706" : Model.PrimaryColor;
    var heroImage = Model.Sector == NfcMenuSaas.Models.BusinessSector.Cevicheria 
        ? "https://images.unsplash.com/photo-1535400255456-984241443b29?w=1200&auto=format&fit=crop&q=80" 
        : "https://images.unsplash.com/photo-1598515214211-89d3c73ae83b?w=1200&auto=format&fit=crop&q=80";
}

<style>
    :root {
        --brand-color: @primary;
    }
    .bg-brand { background-color: var(--brand-color); }
    .text-brand { color: var(--brand-color); }
</style>

<!-- Hero Section con Portada Gastronómica de Alta Definición -->
<div class="relative h-80 w-full overflow-hidden">
    <img src="@heroImage" alt="@Model.Name" class="w-full h-full object-cover brightness-[0.65]" />
    
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>

    <!-- Badge Dominio Propio / Calidad con Icono Vectorial -->
    <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-white/20 backdrop-blur-md text-white border border-white/20 shadow-sm">
            <svg class="w-3.5 h-3.5 text-amber-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            Sitio Oficial
        </span>
        @if (!string.IsNullOrEmpty(Model.CustomDomain))
        {
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono text-emerald-300 bg-emerald-950/80 border border-emerald-500/30">
                <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                @Model.CustomDomain
            </span>
        }
    </div>

    <!-- Título y Presentación en la Portada -->
    <div class="absolute bottom-6 left-5 right-5 text-white">
        <span class="text-xs uppercase tracking-widest text-amber-300 font-bold block mb-1">
            Rubro: @Model.Sector
        </span>
        <h1 class="text-3xl font-black tracking-tight leading-tight drop-shadow-md">
            @Model.Name
        </h1>
        <p class="text-xs text-slate-200 mt-1 flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Abierto ahora • Atención en salón y pedidos
        </p>
    </div>
</div>

<!-- Contenido Principal de la Portada -->
<main class="p-5 space-y-6 -mt-3 relative z-10 bg-white rounded-t-3xl shadow-xl flex-1 flex flex-col justify-between">

    <!-- LLAMADA A LA ACCIÓN PRINCIPAL: VER MENÚ DIGITAL -->
    <div class="space-y-3">
        <a href="/site/@Model.Slug/menu" class="w-full py-4 px-6 rounded-2xl bg-brand text-white font-black text-base shadow-xl shadow-brand/30 flex items-center justify-center gap-2 hover:opacity-95 active:scale-[0.98] transition">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>VER CARTA & MENÚ DIGITAL</span>
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <p class="text-[11px] text-center text-slate-400">
            Consulta platos, precios y disponibilidad en tiempo real
        </p>
    </div>

    <!-- TARJETAS DE DESTACADOS GASTRONÓMICOS CON ICONOS VECTORIALES -->
    <div class="grid grid-cols-2 gap-3">
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
            <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/></svg>
            </div>
            <h3 class="text-xs font-bold text-slate-800">Sabor & Calidad</h3>
            <p class="text-[11px] text-slate-500">Recetas tradicionales e ingredientes frescos del día.</p>
        </div>
        <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-100 space-y-1">
            <div class="w-7 h-7 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-xs font-bold text-slate-800">Pedidos en Mesa</h3>
            <p class="text-[11px] text-slate-500">Acceso táctil instantáneo desde tu tarjeta NFC.</p>
        </div>
    </div>

    <!-- HORARIOS Y UBICACIÓN -->
    <div class="border-t border-slate-100 pt-4 text-xs text-slate-500 space-y-2">
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Lunes a Domingo: 11:30 AM - 10:30 PM</span>
        </div>
        <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span>Salón Principal & Delivery</span>
        </div>
    </div>

    <!-- FOOTER S & D -->
    <footer class="pt-4 text-center border-t border-slate-100">
        <span class="text-[10px] text-slate-400">
            Sitio web & Carta Inteligente desarrollados por <strong class="text-slate-600">S & D - Company Cards</strong>
        </span>
    </footer>
</main>
