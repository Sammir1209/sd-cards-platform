@model NfcMenuSaas.Models.Business
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = Model.Name + " - Portal de Atención";
    var primary = string.IsNullOrEmpty(Model.PrimaryColor) ? "#2563EB" : Model.PrimaryColor;
    var reviewsUrl = !string.IsNullOrEmpty(Model.GoogleMapsUrl) 
        ? Model.GoogleMapsUrl 
        : $"https://www.google.com/maps/search/?api=1&query={System.Net.WebUtility.UrlEncode(Model.Name + " " + (Model.City ?? ""))}";
    var menuUrl = !string.IsNullOrEmpty(Model.CustomDomain)
        ? (Model.CustomDomain.StartsWith("http") ? Model.CustomDomain : "https://" + Model.CustomDomain)
        : $"/m/{Model.Slug}";
    var cleanPhone = string.IsNullOrEmpty(Model.OwnerPhone) ? "" : System.Text.RegularExpressions.Regex.Replace(Model.OwnerPhone, @"[^\d]", "");
}

<style>
    :root {
        --brand-color: @primary;
    }
    .bg-brand { background-color: var(--brand-color); }
    .text-brand { color: var(--brand-color); }
</style>

<main class="flex-1 flex flex-col items-center justify-center text-center px-5 py-8 relative">
    <div class="w-56 h-56 rounded-full bg-brand/10 absolute -top-12 -right-12 blur-3xl pointer-events-none"></div>
    <div class="w-56 h-56 rounded-full bg-cyan-400/10 absolute -bottom-12 -left-12 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-sm flex flex-col items-center">
        
        <!-- Logo o Letra Inicial -->
        @if (!string.IsNullOrEmpty(Model.LogoUrl))
        {
            <img src="@Model.LogoUrl" alt="@Model.Name" class="w-20 h-20 rounded-2xl object-cover shadow-lg ring-2 ring-slate-800 mb-4" />
        }
        else
        {
            <div class="w-20 h-20 rounded-2xl bg-brand text-white flex items-center justify-center text-3xl font-extrabold shadow-lg ring-2 ring-slate-800 mb-4">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>
        }

        <h1 class="text-2xl font-black text-slate-100 tracking-tight">@Model.Name</h1>
        <p class="text-xs text-slate-400 mt-1">@Model.City &bull; Portal Inteligente de Atención</p>

        <!-- ACCIONES PRINCIPALES MULTIFUNCIONALES -->
        <div class="w-full flex flex-col gap-3.5 mt-6">
            
            <!-- 1. BOTÓN GOOGLE REVIEWS -->
            <a href="@reviewsUrl" target="_blank"
               class="flex items-center justify-between w-full px-5 py-4 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-slate-950 font-black text-sm rounded-2xl shadow-lg shadow-amber-500/20 transition transform active:scale-98">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-slate-950 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <div class="text-left">
                        <div class="font-extrabold text-xs uppercase tracking-wider text-slate-950">Google Reviews</div>
                        <div class="text-[13px] font-bold">Calificar con 5 Estrellas</div>
                    </div>
                </div>
                <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>

            <!-- 2. BOTÓN MENÚ DIGITAL -->
            <a href="@menuUrl"
               class="flex items-center justify-between w-full px-5 py-4 bg-slate-800/90 hover:bg-slate-800 border border-slate-700/60 text-slate-100 font-black text-sm rounded-2xl shadow-md transition transform active:scale-98">
                <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    <div class="text-left">
                        <div class="font-extrabold text-[10px] uppercase tracking-wider text-cyan-400">Carta Digital</div>
                        <div class="text-[13px] font-bold text-white">Ver Menú & Precios</div>
                    </div>
                </div>
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>

            <!-- 3. BOTÓN WHATSAPP DIRECTO (SI EXISTE TELÉFONO) -->
            @if (!string.IsNullOrEmpty(cleanPhone))
            {
                <a href="https://wa.me/@cleanPhone?text=@System.Net.WebUtility.UrlEncode("Hola " + Model.Name + ", me comunico desde su tarjeta NFC / QR.")" target="_blank"
                   class="flex items-center justify-between w-full px-5 py-4 bg-emerald-600/90 hover:bg-emerald-600 text-white font-black text-sm rounded-2xl shadow-md transition transform active:scale-98">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        <div class="text-left">
                            <div class="font-extrabold text-[10px] uppercase tracking-wider text-emerald-200">Atención Directa</div>
                            <div class="text-[13px] font-bold text-white">WhatsApp & Pedidos</div>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>
            }

            <!-- 4. BLOQUE WI-FI DEL ESTABLECIMIENTO (SI ESTÁ CONFIGURADO) -->
            @if (!string.IsNullOrEmpty(Model.WifiPassword))
            {
                <div class="w-full bg-slate-900/80 border border-slate-800 rounded-2xl p-4 text-left">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"/></svg>
                            <span class="text-xs font-bold text-slate-300">Wi-Fi del Local</span>
                        </div>
                        <button onclick="navigator.clipboard.writeText('@Model.WifiPassword'); this.innerText='Copiado'; setTimeout(()=>this.innerText='Copiar', 2000);"
                                class="text-[11px] font-bold text-cyan-400 bg-cyan-950/60 border border-cyan-800/40 px-2.5 py-1 rounded-lg hover:bg-cyan-900 transition">
                            Copiar
                        </button>
                    </div>
                    <div class="mt-2 text-xs font-mono font-bold text-slate-100 bg-slate-950 px-3 py-2 rounded-xl border border-slate-800/60">
                        @Model.WifiPassword
                    </div>
                </div>
            }

        </div>

        <div class="mt-8 text-center">
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-slate-400">
                S & D Company Cards &bull; Ecosistema Inteligente
            </span>
        </div>
    </div>
</main>

