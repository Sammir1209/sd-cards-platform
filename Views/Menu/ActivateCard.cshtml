@model NfcMenuSaas.Models.NfcCard
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Activar Tarjeta NFC - S & D - Company Cards";
    string preloadedPin = ViewBag.PreloadedPin as string ?? string.Empty;
}

<!-- Encabezado con Icono SVG Vectorial Premium -->
<header class="bg-slate-950 text-white px-5 py-6 text-center border-b border-white/10 shadow-xl">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-bold mb-2">
        <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        S & D - COMPANY CARDS
    </div>
    <h1 class="text-xl font-black tracking-tight">Activación de Tarjeta NFC</h1>
    <p class="text-xs text-slate-400 mt-1">Negocio: <span class="text-white font-semibold">@Model.Business.Name</span></p>
</header>

<main class="p-6 flex-1 flex flex-col justify-center">
    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-xl space-y-5">
        <div class="text-center">
            <div class="w-14 h-14 mx-auto rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center shadow-inner mb-2">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <h2 class="text-base font-extrabold text-slate-800">Vinculación de Chip</h2>
            <p class="text-xs text-slate-500 mt-0.5">
                Código: <strong class="font-mono text-blue-600 bg-blue-50 px-2 py-0.5 rounded">@Model.CardCode</strong>
            </p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="p-3 rounded-2xl bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                <span>@ViewBag.ErrorMessage</span>
            </div>
        }

        <form method="post" action="/activar/confirmar" class="space-y-4">
            <input type="hidden" name="cardCode" value="@Model.CardCode" />

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">PIN de Activación (4 dígitos)</label>
                <input type="text" name="pin" value="@preloadedPin" maxlength="10" placeholder="1234" required class="w-full px-3 py-2.5 text-center tracking-widest text-lg font-mono font-bold rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                <span class="text-[10px] text-slate-400 block mt-1">Ingresa el código provisto por S & D.</span>
            </div>

            @if (Model.CardType == NfcMenuSaas.Models.TemplateType.GoogleReviews)
            {
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Enlace de Reseña de Google Maps</label>
                    <input type="url" name="googleMapsUrl" value="@Model.Business.GoogleMapsUrl" placeholder="https://search.google.com/local/writereview?placeid=..." required class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono" />
                    <span class="text-[10px] text-slate-400 block mt-1">Los clientes saltarán en 0ms a este enlace al tocar la tarjeta física.</span>
                </div>
            }
            else
            {
                <div class="p-3 bg-blue-50/70 rounded-2xl border border-blue-100 text-blue-900 text-xs flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    <span>Esta tarjeta está lista para el <strong>Menú Digital Online</strong>. Al confirmar se abrirá tu panel para cargar platos.</span>
                </div>
            }

            <button type="submit" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl text-xs font-black shadow-lg shadow-blue-500/30 transition active:scale-95 flex items-center justify-center gap-2">
                <span>Guardar y Activar Tarjeta</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
        </form>
    </div>
</main>
