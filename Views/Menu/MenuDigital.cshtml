@model NfcMenuSaas.Models.Business
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = Model.Name + " - Menú Digital";
    var primary = string.IsNullOrEmpty(Model.PrimaryColor) ? "#2563EB" : Model.PrimaryColor;
}

<style>
    :root {
        --brand-color: @primary;
    }
    .bg-brand { background-color: var(--brand-color); }
    .text-brand { color: var(--brand-color); }
    .border-brand { border-color: var(--brand-color); }
</style>

<!-- Header & Branding del Restaurante -->
<header class="relative bg-slate-900 text-white pt-8 pb-6 px-5 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-slate-800 opacity-90"></div>
    @if (!string.IsNullOrEmpty(Model.LogoUrl))
    {
        <div class="absolute -right-6 -bottom-6 w-32 h-32 opacity-10 rounded-full blur-xl bg-white"></div>
    }

    <div class="relative z-10 flex items-center space-x-4">
        @if (!string.IsNullOrEmpty(Model.LogoUrl))
        {
            <img src="@Model.LogoUrl" alt="@Model.Name" class="w-16 h-16 rounded-2xl object-cover ring-2 ring-white/20 shadow-lg shrink-0" />
        }
        else
        {
            <div class="w-16 h-16 rounded-2xl bg-brand text-white flex items-center justify-center text-2xl font-bold shadow-lg shrink-0">
                @Model.Name.Substring(0, 1).ToUpper()
            </div>
        }
        <div class="flex-1 min-w-0">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span> Carta Activa
            </span>
            <h1 class="text-xl font-extrabold tracking-tight truncate leading-tight">@Model.Name</h1>
            <p class="text-xs text-slate-300 mt-0.5">Rubro: @Model.Sector</p>
        </div>
    </div>
</header>

<!-- Barra Navegación de Categorías (Pill Slider Horizontal) -->
<nav class="sticky top-0 z-30 bg-white/95 backdrop-blur border-b border-slate-100 px-4 py-3 hide-scrollbar flex space-x-2 overflow-x-auto shadow-sm">
    @foreach (var cat in Model.Categories)
    {
        <a href="#cat-@cat.Id" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition active:scale-95">
            @cat.Name
        </a>
    }
</nav>

<!-- Lista de Platos por Categoría -->
<main class="px-4 py-6 space-y-8 flex-1">
    @if (!Model.Categories.Any())
    {
        <div class="text-center py-12">
            <p class="text-sm text-slate-400">Pronto se cargarán los platos de este menú.</p>
        </div>
    }

    @foreach (var cat in Model.Categories)
    {
        <section id="cat-@cat.Id" class="scroll-mt-16">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-base font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <span class="w-1.5 h-4 bg-brand rounded-full"></span>
                    @cat.Name
                </h2>
                <span class="text-xs font-medium text-slate-400">@cat.Dishes.Count items</span>
            </div>

            <div class="space-y-3">
                @foreach (var dish in cat.Dishes)
                {
                    <article class="bg-white rounded-2xl p-3 border border-slate-100 shadow-sm flex items-start gap-3 hover:border-slate-200 transition">
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm leading-snug">@dish.Name</h3>
                            @if (!string.IsNullOrEmpty(dish.Description))
                            {
                                <p class="text-xs text-slate-500 mt-1 line-clamp-2 leading-relaxed">@dish.Description</p>
                            }
                            <div class="mt-2.5 flex items-center justify-between">
                                <span class="text-sm font-extrabold text-slate-900 bg-slate-50 px-2 py-0.5 rounded-lg border border-slate-200">
                                    S/ @dish.Price.ToString("F2")
                                </span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(dish.ImageUrl))
                        {
                            <img src="@dish.ImageUrl" alt="@dish.Name" class="w-20 h-20 rounded-xl object-cover shrink-0 shadow-sm bg-slate-100" loading="lazy" />
                        }
                    </article>
                }
            </div>
        </section>
    }
</main>

<footer class="text-center pt-4 pb-2 text-[11px] text-slate-400 border-t border-slate-100">
    Desarrollado con <span class="font-semibold text-slate-600">S & D - Company Cards</span>
</footer>
