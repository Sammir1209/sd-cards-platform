@model string
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Negocio Inactivo";
}

<div class="flex-1 flex flex-col items-center justify-center text-center px-6 py-12">
    <div class="w-16 h-16 rounded-full bg-amber-50 text-amber-500 flex items-center justify-center text-2xl font-bold mb-4">
        !
    </div>
    <h1 class="text-xl font-bold text-slate-800">Servicio pausado</h1>
    <p class="text-sm text-slate-500 mt-2 max-w-xs">
        La carta o sitio de <span class="font-bold text-slate-700">@Model</span> se encuentra actualmente inactivo.
    </p>
</div>

